# Owner dashboard credentials (server-side only). Set a long random username/password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional analytics provider credentials. Leave empty to show empty states.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Optional server-only Plausible Stats API settings for the /admin dashboard.
ANALYTICS_API_TOKEN=
ANALYTICS_BASE_URL=https://plausible.io
