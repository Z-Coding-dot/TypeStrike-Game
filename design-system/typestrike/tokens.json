{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "TypeStrike design tokens (dark theme). Mirror of src/styles/design-tokens.css, which is the live source of truth.",
  "color": {
    "bg": {
      "base": { "$value": "#050b14", "$type": "color" },
      "surface": { "$value": "#0a1423", "$type": "color" },
      "elevated": { "$value": "#101d31", "$type": "color" },
      "input": { "$value": "#0d1728", "$type": "color" }
    },
    "brand": {
      "primary": { "$value": "#22d3ee", "$type": "color" },
      "primary-strong": { "$value": "#06b6d4", "$type": "color" },
      "secondary": { "$value": "#3b82f6", "$type": "color" },
      "accent": { "$value": "#8b5cf6", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#34d399", "$type": "color" },
      "warning": { "$value": "#fbbf24", "$type": "color" },
      "danger": { "$value": "#f87171", "$type": "color" }
    },
    "on": {
      "primary": { "$value": "#04121c", "$type": "color" },
      "secondary": { "$value": "#ffffff", "$type": "color" },
      "accent": { "$value": "#ffffff", "$type": "color" },
      "danger": { "$value": "#1a0707", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#f1f5f9", "$type": "color" },
      "secondary": { "$value": "#b6c4d6", "$type": "color" },
      "muted": { "$value": "#8296ad", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "rgba(148, 163, 184, 0.16)", "$type": "color" },
      "medium": { "$value": "rgba(148, 163, 184, 0.28)", "$type": "color" },
      "accent": { "$value": "rgba(34, 211, 238, 0.45)", "$type": "color" }
    },
    "surface": {
      "hover": { "$value": "rgba(148, 163, 184, 0.1)", "$type": "color" },
      "selected": { "$value": "rgba(34, 211, 238, 0.1)", "$type": "color" },
      "header": { "$value": "rgba(5, 11, 20, 0.96)", "$type": "color" },
      "backdrop": { "$value": "rgba(2, 6, 14, 0.72)", "$type": "color" }
    }
  },
  "font": {
    "en": { "$value": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$type": "fontFamily" },
    "fa": { "$value": "\"Vazirmatn\", \"Inter\", system-ui, sans-serif", "$type": "fontFamily" }
  },
  "size": {
    "text": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "2rem", "$type": "dimension" },
      "4xl": { "$value": "2.5rem", "$type": "dimension" }
    },
    "space": {
      "unit": { "$value": "0.5rem", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension" },
      "md": { "$value": "10px", "$type": "dimension" },
      "lg": { "$value": "14px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "220ms", "$type": "duration" },
      "slow": { "$value": "360ms", "$type": "duration" }
    },
    "ease": {
      "standard": { "$value": "cubic-bezier(0.2, 0.7, 0.2, 1)", "$type": "cubicBezier" }
    }
  },
  "layout": {
    "header-height": { "$value": "64px", "$type": "dimension" },
    "max-content-width": { "$value": "1440px", "$type": "dimension" },
    "touch-target": { "$value": "44px", "$type": "dimension" }
  },
  "semantic": {
    "layer": {
      "app": { "$value": "{color.bg.base}", "$type": "color" },
      "surface": { "$value": "{color.bg.surface}", "$type": "color" },
      "raised": { "$value": "{color.bg.elevated}", "$type": "color" },
      "input": { "$value": "{color.bg.input}", "$type": "color" },
      "header": { "$value": "{color.surface.header}", "$type": "color" },
      "backdrop": { "$value": "{color.surface.backdrop}", "$type": "color" },
      "hover": { "$value": "{color.surface.hover}", "$type": "color" },
      "selected": { "$value": "{color.surface.selected}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.border.subtle}", "$type": "color" },
      "strong": { "$value": "{color.border.medium}", "$type": "color" },
      "accent": { "$value": "{color.border.accent}", "$type": "color" }
    },
    "text": {
      "strong": { "$value": "{color.text.primary}", "$type": "color" },
      "default": { "$value": "{color.text.secondary}", "$type": "color" },
      "subtle": { "$value": "{color.text.muted}", "$type": "color" }
    },
    "action": {
      "primary-bg": { "$value": "{color.brand.primary}", "$type": "color" },
      "primary-bg-hover": { "$value": "{color.brand.primary-strong}", "$type": "color" },
      "primary-fg": { "$value": "{color.on.primary}", "$type": "color" },
      "secondary-bg": { "$value": "{color.bg.elevated}", "$type": "color" },
      "secondary-fg": { "$value": "{color.text.primary}", "$type": "color" },
      "danger-fg": { "$value": "{color.status.danger}", "$type": "color" }
    },
    "status": {
      "success": { "$value": "{color.status.success}", "$type": "color" },
      "warning": { "$value": "{color.status.warning}", "$type": "color" },
      "danger": { "$value": "{color.status.danger}", "$type": "color" }
    },
    "focus": {
      "ring": { "$value": "{color.brand.primary}", "$type": "color" },
      "width": { "$value": "2px", "$type": "dimension" }
    },
    "type": {
      "body": { "$value": "{font.en}", "$type": "fontFamily" },
      "heading": { "$value": "{font.en}", "$type": "fontFamily" },
      "display": { "$value": "{size.text.4xl}", "$type": "dimension" },
      "heading-1": { "$value": "{size.text.3xl}", "$type": "dimension" },
      "heading-2": { "$value": "{size.text.2xl}", "$type": "dimension" },
      "heading-3": { "$value": "{size.text.xl}", "$type": "dimension" },
      "body-sm": { "$value": "{size.text.sm}", "$type": "dimension" },
      "caption": { "$value": "{size.text.xs}", "$type": "dimension" }
    },
    "radius": {
      "control": { "$value": "{size.radius.md}", "$type": "dimension" },
      "surface": { "$value": "{size.radius.lg}", "$type": "dimension" }
    },
    "motion": {
      "fast": { "$value": "{motion.duration.fast}", "$type": "duration" },
      "normal": { "$value": "{motion.duration.normal}", "$type": "duration" },
      "ease": { "$value": "{motion.ease.standard}", "$type": "cubicBezier" }
    }
  }
}
